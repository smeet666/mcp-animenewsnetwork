    {
      "name": "list_recent",
      "title": "List recent or browse alphabetically",
      "description": "List what was added to the Anime News Network encyclopedia most recently: anime, manga, people or companies. Pass 'starts_with' to browse titles alphabetically instead, which only applies to anime and manga. Rows carry an id you can pass to get_title when the kind is anime or manga. This is a listing, not a search: use search_titles when you know what you are looking for.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "default": "anime",
            "description": "Which catalogue to list.",
            "type": "string",
            "enum": ["anime", "manga", "person", "company"]
          },
          "starts_with": {
            "description": "Single letter. Switches to an alphabetical browse of titles. Anime and manga only.",
            "type": "string",
            "maxLength": 1
          },
          "limit": {
            "default": 20,
            "description": "How many rows to return.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "default": 0,
            "description": "How many rows to skip, for paging.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": ["recent", "browse"],
            "description": "'recent' is by date added, 'browse' is alphabetical."
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "kind": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": ["anime", "manga", "person", "company"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "precision": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "vintage": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "date_added": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_url": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "kind",
                "name",
                "type",
                "precision",
                "vintage",
                "date_added",
                "source_url"
              ],
              "additionalProperties": false
            }
          },
          "offset": {
            "type": "integer",
            "minimum": -9007199254740991,
