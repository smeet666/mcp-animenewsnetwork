                "type": "string"
              },
              "precision": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Disambiguator the site shows next to the name, such as 'TV 2'."
              },
              "vintage": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Original release date or range, as published."
              },
              "source_url": {
                "type": "string",
