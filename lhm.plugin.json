    {
      "name": "get_news",
      "title": "Read the news wire",
      "description": "Read the latest Anime News Network stories from their RSS feeds. 'all' mixes news, reviews and features; 'news' and 'reviews' are the narrower feeds. Filter with 'category' to keep only stories the feed tags a given way, such as Manga or Anime. The feed is the whole window available: there is no way to reach older stories through this tool. When you repeat a story, cite Anime News Network and link the article.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "feed": {
            "default": "all",
            "description": "Which feed to read. 'all' is the busiest.",
            "type": "string",
            "enum": ["all", "news", "reviews"]
          },
          "edition": {
            "default": "us",
            "description": "Regional edition. They differ mostly in release and licensing coverage.",
            "type": "string",
            "enum": ["us", "uk", "au"]
          },
          "category": {
            "description": "Keep only items tagged this way, matched case-insensitively.",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "description": "How many stories to return.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "feed": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "link": {
                  "type": "string",
                  "description": "Article URL. Show this when citing the story."
                },
                "summary": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "published_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "ISO 8601 when the feed date could be parsed."
                },
                "category": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
