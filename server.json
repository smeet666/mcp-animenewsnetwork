{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.smeet666/mcp-animenewsnetwork",
  "description": "Search the Anime News Network encyclopedia and read its news wire. No API key.",
  "websiteUrl": "https://github.com/smeet666/mcp-animenewsnetwork#readme",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/smeet666/mcp-animenewsnetwork/main/assets/icon-128.png",
      "mimeType": "image/png",
      "sizes": ["128x128"]
    },
    {
      "src": "https://raw.githubusercontent.com/smeet666/mcp-animenewsnetwork/main/assets/icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "repository": {
    "url": "https://github.com/smeet666/mcp-animenewsnetwork",
    "source": "github"
  },
  "version": "2.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mcp-animenewsnetwork",
      "version": "2.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ANN_USER_AGENT",
          "description": "Override the User-Agent sent to Anime News Network.",
          "isRequired": false
        },
        {
          "name": "ANN_MIN_INTERVAL_MS",
          "description": "Minimum milliseconds between requests. Default 1100, floor 1000.",
          "isRequired": false
        },
        {
          "name": "ANN_LOG_LEVEL",
          "description": "silent, error, info or debug. Default error.",
          "isRequired": false
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/smeet666/mcp-animenewsnetwork/releases/download/v2.0.0/mcp-animenewsnetwork-2.0.0.mcpb",
      "version": "2.0.0",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
